data x86_64-apple-darwin$write(data&, data) {
    mov rcx, 0 // Set counter to zero
    loop:
        cmp byte ptr [rdi + rcx], 0 // Is null terminator?
        je done // Yes? Break
        inc rcx
        jmp loop
    done:
        mov rax, 0x2000004 // Write
        mov rsi, rdi       // ptr
        mov rdx, rcx       // length
        mov rdi, 1         // stdout
        syscall
        ret
}

data x86_64-linux-gnu$print(data) {
    .extern _puts
    jmp _puts
}
